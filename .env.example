# Environment Variables

# Database (Supabase PostgreSQL)
# DATABASE_URL should use Supavisor's pooled connection string for runtime queries.
# DIRECT_URL should use the direct database connection string for Prisma migrations.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Session secret (generate a long random value for production)
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: AI provider (leave empty to use built-in Z.AI SDK)
# AI_PROVIDER=openai-compatible
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
